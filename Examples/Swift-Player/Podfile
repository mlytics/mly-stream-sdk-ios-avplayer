platform :ios, '14.0'

target 'Swift-Player' do 
  use_frameworks! 
  pod 'MLYSDK',:git => 'https://github.com/mlytics/mly-stream-sdk-ios-avplayer.git'
  pod 'MLYAVPlayer',:git => 'https://github.com/mlytics/mly-stream-sdk-ios-avplayer.git'

  pod 'WebRTC-SDK', :modular_headers => true
  pod 'Sentry', :modular_headers => true  
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['SWIFT_VERSION'] = '5.9'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['SWIFT_INSTALL_OBJC_HEADER'] = 'NO'
      config.build_settings['EMBEDDED_CONTENT_CONTAINS_SWIFT'] = 'YES'
      config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'

      # 添加 bundle 資源處理
      config.build_settings['SKIP_INSTALL'] = 'NO'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      
      # 確保 framework 正確嵌入
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] = ['$(inherited)', '$(PLATFORM_DIR)/Developer/Library/Frameworks']
      
      # XCFramework 相關設定
      if target.name.include?('WebRTC-SDK')
        config.build_settings['SUPPORTS_MACCATALYST'] = 'NO'
        config.build_settings['VALIDATE_WORKSPACE'] = 'YES'
      end
      
      # Sentry 相關設定
      if target.name.include?('Sentry')
        config.build_settings['SUPPORTS_MACCATALYST'] = 'NO'
        config.build_settings['SKIP_INSTALL'] = 'NO'
        config.build_settings['COPY_PHASE_STRIP'] = 'NO'
      end      

      xcconfig_path = config.base_configuration_reference.real_path
      xcconfig = File.read(xcconfig_path)
      xcconfig_mod = xcconfig.gsub(/DT_TOOLCHAIN_DIR/, "TOOLCHAIN_DIR")
      File.open(xcconfig_path, "w") { |file| file << xcconfig_mod }
    end
  end
end
